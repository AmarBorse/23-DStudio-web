# Copy to .env.local on your computer, and add the same names in Vercel → Settings → Environment Variables.

# Admin login (/admin)
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=any-long-random-text-at-least-32-characters

# Supabase (database + image storage). Leave empty on your computer to save data in the .data folder instead.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
